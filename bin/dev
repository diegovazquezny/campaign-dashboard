#!/usr/bin/env bash
# Runs the API (port 3001) and web app (port 3000) together; Ctrl-C stops both.
set -uo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

pids=()
cleanup() {
  trap - INT TERM EXIT
  kill "${pids[@]}" 2>/dev/null
  wait 2>/dev/null
}
trap cleanup INT TERM EXIT

(cd "$ROOT/api" && exec bin/rails s -p 3001) &
pids+=($!)
(cd "$ROOT/dashboard-ui" && API_URL="${API_URL:-http://localhost:3001}" exec npm run dev) &
pids+=($!)

# Exit as soon as either process stops, then clean up the other.
# (Polls instead of `wait -n`, which macOS's bash 3.2 lacks.)
while kill -0 "${pids[0]}" 2>/dev/null && kill -0 "${pids[1]}" 2>/dev/null; do
  sleep 1
done
