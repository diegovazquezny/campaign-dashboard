        <mxCell id="epr8-pr9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="pr8" target="pr9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="epr7-pr10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="pr7" target="pr10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="epr8-pr10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="pr8" target="pr10"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="legend" value="&lt;b&gt;How to read this&lt;/b&gt;&lt;br&gt;&amp;bull; PR 1 and PR 3 have no prerequisites and can start together.&lt;br&gt;&amp;bull; PR 5 is the join point of the metrics track: it needs coverage (PR 2), spend (PR 3) and call facts (PR 4).&lt;br&gt;&amp;bull; PR 8 (daily endpoint) needs the same three and runs in parallel with PR 5&amp;ndash;7.&lt;br&gt;&amp;bull; PR 9 and PR 10 need both endpoints (PR 7 and PR 8) and run in parallel.&lt;br&gt;&amp;bull; Longest chain, which sets the finish date: PR 1 &amp;rarr; 2 (or 4) &amp;rarr; 5 &amp;rarr; 6 &amp;rarr; 7 &amp;rarr; 9 (or 10) (6 PRs in sequence)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="780" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="key" value="&lt;b&gt;Colors&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="860" y="600" width="100" height="20" as="geometry"/>
        </mxCell>
