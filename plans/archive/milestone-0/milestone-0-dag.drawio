<mxfile host="app.diagrams.net">
  <diagram id="m0-dag" name="Milestone 0 - PR dependencies">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Milestone 0: Working skeleton&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Which pull requests (PRs) can run side by side, and which must wait. Arrows mean &quot;must be merged first&quot;.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1200" height="50" as="geometry"/>
        </mxCell>

        <!-- Lanes -->
        <mxCell id="lane-api" value="&lt;b&gt;API track&lt;/b&gt; (Rails)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#9DBDE0;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#1F4E79;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="230" y="80" width="1060" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="lane-web" value="&lt;b&gt;Web track&lt;/b&gt; (Next.js)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6EC;strokeColor=#9FCFA6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#2E6B3A;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="230" y="260" width="1060" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="parallel-note" value="Two people can work in these two lanes at the same time" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="230" y="210" width="1060" height="30" as="geometry"/>
        </mxCell>

        <!-- Nodes: API track (y=110) -->
        <mxCell id="pr1" value="&lt;b&gt;PR 1&lt;/b&gt;&lt;br&gt;Add the backend starter code&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;generated, skim only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="110" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="pr3" value="&lt;b&gt;PR 3&lt;/b&gt;&lt;br&gt;Remove unused deploy tooling&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;deletions only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="110" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="pr4" value="&lt;b&gt;PR 4&lt;/b&gt;&lt;br&gt;Switch database to PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="110" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="pr5" value="&lt;b&gt;PR 5&lt;/b&gt;&lt;br&gt;Switch backend tests to RSpec" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="110" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="pr8" value="&lt;b&gt;PR 8&lt;/b&gt;&lt;br&gt;Docker: database + API&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;first one-command run&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1090" y="110" width="170" height="70" as="geometry"/>
        </mxCell>

        <!-- Nodes: Web track (y=290) -->
        <mxCell id="pr2" value="&lt;b&gt;PR 2&lt;/b&gt;&lt;br&gt;Add the frontend starter code&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;generated, skim only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="290" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="pr6" value="&lt;b&gt;PR 6&lt;/b&gt;&lt;br&gt;Add frontend test tooling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="290" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="pr7" value="&lt;b&gt;PR 7&lt;/b&gt;&lt;br&gt;Hello page that checks the API is up" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="290" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="slack" value="Web track finishes early&lt;br&gt;and waits for PR 8" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#2E6B3A;" vertex="1" parent="1">
          <mxGeometry x="880" y="305" width="170" height="40" as="geometry"/>
        </mxCell>

        <!-- Shared nodes (y=210 center line between lanes is used by note, so place at mid-height) -->
        <mxCell id="pr0" value="&lt;b&gt;PR 0&lt;/b&gt;&lt;br&gt;Set up the repository&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;direct commit, no review&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="pr9" value="&lt;b&gt;PR 9&lt;/b&gt;&lt;br&gt;Docker: add the web app&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;needs BOTH tracks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1340" y="200" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="pr10" value="&lt;b&gt;PR 10&lt;/b&gt;&lt;br&gt;Run without Docker&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;setup and dev scripts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1560" y="200" width="170" height="70" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e0-1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="pr0" target="pr1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e0-2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="pr0" target="pr2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="pr1" target="pr3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3-4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="pr3" target="pr4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4-5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="pr4" target="pr5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5-8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="pr5" target="pr8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2-6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="pr2" target="pr6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6-7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="pr6" target="pr7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8-9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="pr8" target="pr9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7-9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;dashed=1;" edge="1" parent="1" source="pr7" target="pr9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="400"/><mxPoint x="1425" y="400"/></Array></mxGeometry></mxCell>
        <mxCell id="e9-10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="pr9" target="pr10"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Legend / how to read -->
        <mxCell id="legend" value="&lt;b&gt;How to read this&lt;/b&gt;&lt;br&gt;&amp;bull; Boxes in different lanes at the same horizontal position can be built at the same time.&lt;br&gt;&amp;bull; PR 1 and PR 2 can start as soon as PR 0 is in. They don&amp;#39;t depend on each other.&lt;br&gt;&amp;bull; PR 9 is the join point: it needs the API track (PR 8) and the web track (PR 7) both merged.&lt;br&gt;&amp;bull; Longest chain, which sets the finish date: PR 0 &amp;rarr; 1 &amp;rarr; 3 &amp;rarr; 4 &amp;rarr; 5 &amp;rarr; 8 &amp;rarr; 9 &amp;rarr; 10 (8 PRs in sequence).&lt;br&gt;&amp;bull; Web track (PR 2, 6, 7) has slack: it can slip without delaying the finish, as long as it lands before PR 8." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="780" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="key" value="&lt;b&gt;Colors&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="860" y="430" width="100" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="key-shared" value="Setup (shared)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="860" y="455" width="130" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="key-api" value="API track" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1000" y="455" width="130" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="key-web" value="Web track" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1140" y="455" width="130" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="key-join" value="Needs both tracks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1280" y="455" width="130" height="28" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
