<mxfile host="app.diagrams.net">
  <diagram id="m1-dag" name="Milestone 1 - PR dependencies">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;Milestone 1: Data model + import pipeline&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Which pull requests (PRs) can run side by side, and which must wait. Arrows mean &quot;must be merged first&quot;.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1200" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="lane-schema" value="&lt;b&gt;Schema track&lt;/b&gt; (migrations + models)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#9DBDE0;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#1F4E79;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="520" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="lane-import" value="&lt;b&gt;Importer track&lt;/b&gt; (Ruby services)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6EC;strokeColor=#9FCFA6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#2E6B3A;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="520" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="lane-test" value="&lt;b&gt;Test data track&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#E6D28A;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#8A6D00;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="490" width="520" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="pr1" value="&lt;b&gt;PR 1&lt;/b&gt;&lt;br&gt;Reference tables + channel list&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;migrations, models&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="110" width="190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="pr2" value="&lt;b&gt;PR 2&lt;/b&gt;&lt;br&gt;calls table, constraints, indexes&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;migration, model&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="110" width="190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="pr4" value="&lt;b&gt;PR 4&lt;/b&gt;&lt;br&gt;Load locations and campaigns&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ReferenceLoader&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="260" width="190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="pr5" value="&lt;b&gt;PR 5&lt;/b&gt;&lt;br&gt;Call row validation + reader&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pure Ruby&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="260" width="190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="pr3" value="&lt;b&gt;PR 3&lt;/b&gt;&lt;br&gt;Fixture CSVs + helper&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;test data only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="520" width="190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="pr6" value="&lt;b&gt;PR 6a&lt;/b&gt;&lt;br&gt;Staging, latest-version upsert, transaction&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Importer.run&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="260" width="190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="pr6b" value="&lt;b&gt;PR 6b&lt;/b&gt;&lt;br&gt;Stale local_date recompute + rollback specs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="865" y="260" width="190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="pr7" value="&lt;b&gt;PR 7&lt;/b&gt;&lt;br&gt;Seeds, import:all, summary, real data&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;M1 finish line&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1130" y="260" width="190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="epr1-pr2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="pr1" target="pr2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="epr1-pr4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="pr1" target="pr4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="epr1-pr5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="pr1" target="pr5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="epr2-pr6a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="pr2" target="pr6a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="epr4-pr6a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="pr4" target="pr6a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="epr5-pr6a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="pr5" target="pr6a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="epr3-pr6a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="pr3" target="pr6a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="epr6b-pr7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="pr6b" target="pr7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="epr6a-pr6b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="pr6a" target="pr6b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;How to read this&lt;/b&gt;&lt;br&gt;&amp;bull; PR 3 has no prerequisites: start it on day one, in parallel with everything else (PR 4 and PR 5 specs are self-contained).&lt;br&gt;&amp;bull; PR 1 unlocks PR 2, PR 4 and PR 5, which are independent of each other.&lt;br&gt;&amp;bull; PR 6a is the join point: it needs the schema (PR 2), both importer halves (PR 4, PR 5) and the fixtures (PR 3).&lt;br&gt;&amp;bull; Longest chain, which sets the finish date: PR 1 &amp;rarr; 4 (or 2, or 5) &amp;rarr; 6a &amp;rarr; 6b &amp;rarr; 7 (5 PRs in sequence)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="400" width="760" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="key" value="&lt;b&gt;Colors&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="540" width="100" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="key-schema" value="Schema track" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="565" width="130" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="key-import" value="Importer track" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="565" width="130" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="key-test" value="Test data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="565" width="130" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="key-join" value="Needs several tracks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="565" width="130" height="28" as="geometry"/>
        </mxCell>
