<mxfile host="app.diagrams.net">
  <diagram id="tooltips-dag" name="Tooltips - PR dependencies">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>


<mxCell id="title" value="&lt;b&gt;Tooltips: info icons on cards and table headers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Which pull requests (PRs) can run side by side, and which must wait. Arrows mean &quot;must be merged first&quot;.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="50" as="geometry"/></mxCell>
<mxCell id="main" value="&lt;b&gt;main&lt;/b&gt;&lt;br&gt;UI improvements merged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="165" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="t1" value="&lt;b&gt;T1&lt;/b&gt;&lt;br&gt;InfoTip + help text + KPI and missed-calls cards (+ plan docs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="165" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="main" target="t1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="t2" value="&lt;b&gt;T2&lt;/b&gt;&lt;br&gt;Table column headers (campaign, daily, calls)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="90" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="t1" target="t2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="t3" value="&lt;b&gt;T3&lt;/b&gt;&lt;br&gt;Chart cards + call detail cards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="240" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="t1" target="t3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="t4" value="&lt;b&gt;T4&lt;/b&gt;&lt;br&gt;Exit check in both themes, desktop and phone&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;needs T2, T3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="165" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="b2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="t2" target="t4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="b3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="t3" target="t4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="legend" value="&lt;b&gt;How to read this&lt;/b&gt;&lt;br&gt;&amp;bull; T1 goes first: it builds the InfoTip component and holds all the tooltip text.&lt;br&gt;&amp;bull; T2 and T3 touch different files and can run side by side.&lt;br&gt;&amp;bull; T4 is the join point: the visual exit check.&lt;br&gt;&amp;bull; Longest chain: T1 &amp;rarr; T2 (or T3) &amp;rarr; T4 (3 PRs in sequence)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="780" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
